<Project Sdk="Microsoft.NET.Sdk">
  <!-- K-21: links the REAL PromotedCharactersIntegration + MemoryOwnerAuthority
       (SampleMemoryCurrentOwnerPlayer), MemoryProtagonistSource, MemoryOwnerProofPolicy
       and EntityAnchors against the lifecycle game stubs. No RPH, Essential or GTA is
       loaded. The control pipe is never started, so this runs under Mono on Linux. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net481</TargetFramework><LangVersion>latest</LangVersion>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OwnerAuthoritySource Condition="'$(OwnerAuthoritySource)'==''">../MemoryOwnerAuthority.cs</OwnerAuthoritySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../lifecycle-tests/GameStubs.cs" Link="GameStubs.cs" />
    <Compile Include="$(OwnerAuthoritySource)" Link="MemoryOwnerAuthority.cs" />
    <Compile Include="../PromotedCharactersIntegration.cs" Link="PromotedCharactersIntegration.cs" />
    <Compile Include="../lifecycle-tests/VoicePresenceHarnessStub.cs" Link="VoicePresenceHarnessStub.cs" />
    <Compile Include="../ActivityCommands.cs" Link="ActivityCommands.cs" />
    <Compile Include="../../activities/ActivityContracts.cs" Link="ActivityContracts.cs" />
    <Compile Include="../../activities/CapabilityTable.cs" Link="CapabilityTable.cs" />
    <Compile Include="../../activities/ActivityChannel.cs" Link="ActivityChannel.cs" />
    <Compile Include="../../activities/StepMachine.cs" Link="StepMachine.cs" />
    <Compile Include="../../activities/SupersessionMonitor.cs" Link="SupersessionMonitor.cs" />
    <Compile Include="../../activities/StepRunner.cs" Link="StepRunner.cs" />
    <Compile Include="../../activities/CompletionAdapters.cs" Link="CompletionAdapters.cs" />
    <Compile Include="../../activities/PlaceTable.cs" Link="PlaceTable.cs" />
    <Compile Include="../../activities/ActivityWorld.cs" Link="ActivityWorld.cs" />
    <Compile Include="../ControlChannel.cs" Link="ControlChannel.cs" />
    <EmbeddedResource Include="../../../contracts/activity-capabilities.v1.json" LogicalName="LSA.Activities.activity-capabilities.v1.json" />
    <Compile Include="../NativeSafetyPolicy.cs" Link="NativeSafetyPolicy.cs" />
    <Compile Include="../NativeCommands.cs" Link="NativeCommands.cs" />
    <Compile Include="../LocalCommandQueue.cs" Link="LocalCommandQueue.cs" />
    <Compile Include="../TalkTargetPolicy.cs;../TalkPttSession.cs;../TalkTargetGeometry.cs;../TalkTargetIndicator.cs;../EssentialMicState.cs;../TalkTargetSelector.cs" />
    <Compile Include="../../intelligence/MemoryOwnerProofPolicy.cs" Link="MemoryOwnerProofPolicy.cs" />
    <Compile Include="../../intelligence/MemoryProtagonistSource.cs" Link="MemoryProtagonistSource.cs" />
    <Compile Include="../HostContext.cs" Link="HostContext.cs" />
    <Compile Include="../../intelligence/EntityAnchors.cs" Link="EntityAnchors.cs" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
