<Project Sdk="Microsoft.NET.Sdk">
  <!-- The production runtime sources linked against game substitutes, under the
       runtime's real assembly name so the real DomainHost can load and reflect into it. -->
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework><AssemblyName>LSA.PromotedCharacters.Runtime</AssemblyName><LangVersion>latest</LangVersion>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Driver.cs" />
    <Compile Include="../../RuntimeEntry.cs" Link="RuntimeEntry.cs" />
    <Compile Include="../../PromotedCharactersIntegration.cs" Link="PromotedCharactersIntegration.cs" />
    <Compile Include="../../NativeCommands.cs" Link="NativeCommands.cs" />
    <Compile Include="../../LocalCommandQueue.cs" Link="LocalCommandQueue.cs" />
    <Compile Include="../../ControlChannel.cs" Link="ControlChannel.cs" />
    <Compile Include="../../NativeSafetyPolicy.cs" Link="NativeSafetyPolicy.cs" />
    <Compile Include="../../lifecycle-tests/GameStubs.cs" Link="GameStubs.cs" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
<ItemGroup><Compile Include="../../InputLeaseState.cs;../../EssentialInputInterception.cs" /></ItemGroup></Project>
