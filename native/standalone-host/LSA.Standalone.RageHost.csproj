<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>LSA.Standalone.RageHost</AssemblyName>
    <RootNamespace>LSA.Standalone.RageHost</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EntryPoint.cs;BindingFailureDiagnostics.cs;PinnedActorLookup.cs;RageWorldAdapters.cs;StandalonePipeServer.cs;StandaloneTypedCommands.cs;StandaloneOnscreenInput.cs;WaveOutSpatialOutput.cs;RageLipSyncPresenter.cs;StandaloneAutoSmoke.cs" />
    <ProjectReference Include="../standalone/LSA.Standalone.Core.csproj" SetTargetFramework="TargetFramework=net481" />
    <Reference Include="$(RphReferencePath)">
      <HintPath>$(RphReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- Fail BEFORE compilation if MSBuild resolved a cached/fake test DLL.
       The official 1.131 SDK file is named RagePluginHookSDK.dll but its
       internal CLR assembly identity is RagePluginHook (as in NuGet 1.124).
       Select by CLR identity, then demand exact requested-vs-resolved path. -->
  <Target Name="VerifyRphReferenceResolution" AfterTargets="ResolveReferences" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ExpectedRphFullPath>$([MSBuild]::NormalizePath('$(RphReferencePath)'))</_ExpectedRphFullPath>
    </PropertyGroup>
    <ItemGroup>
      <_VerifiedRph Include="@(ReferencePath)"
                    Condition="'%(ReferencePath.FusionName)' != '' And $([System.String]::Copy('%(ReferencePath.FusionName)').StartsWith('RagePluginHook,'))" />
    </ItemGroup>
    <Message Importance="high" Text="RPH compile reference requested=$(_ExpectedRphFullPath) resolved=@(_VerifiedRph)" />
    <Error Condition="'@(_VerifiedRph->Count())' != '1'"
           Text="Exactly one RagePluginHook CLR assembly reference must resolve; refusing missing/ambiguous SDK selection." />
    <Error Condition="'@(_VerifiedRph)' != '$(_ExpectedRphFullPath)'"
           Text="RPH compile reference does not equal the requested official SDK path. Refusing cached/fake assembly resolution." />
  </Target>
  <Target Name="RequireRealRphSdk" BeforeTargets="ResolveReferences" Condition="'$(RphReferencePath)' == '' or !Exists('$(RphReferencePath)')">
    <Error Text="Supply -p:RphReferencePath=&lt;approved RagePluginHook.dll or RagePluginHookSDK.dll&gt;; no RPH SDK is bundled." />
  </Target>
</Project>
