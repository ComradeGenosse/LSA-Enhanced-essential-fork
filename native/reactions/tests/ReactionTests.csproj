<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests: compiles the reaction policy/executor against small stand-ins
       for RAGE/Essential (GameStub.cs). It proves our logic and the exact natives we
       call; it does NOT prove GTA V Enhanced animation behavior. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="GameStub.cs" />
    <Compile Include="../ReactionCatalog.cs" Link="ReactionCatalog.cs" />
    <Compile Include="../ReactionFrame.cs" Link="ReactionFrame.cs" />
    <Compile Include="../ReactionPolicy.cs" Link="ReactionPolicy.cs" />
    <Compile Include="../ReactionExecutor.cs" Link="ReactionExecutor.cs" />
  </ItemGroup>
</Project>
