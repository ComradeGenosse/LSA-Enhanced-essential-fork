  "proposedContracts": [
    {
      "id": "C-01",
      "name": "UtteranceLifecycle v1 + SpeechCaptureReceipt v2",
      "owner": "Plane 2 (P2 host) at Essential mic boundary",
      "consumers": [
        "companion turn pipeline",
        "PS2",
        "social routing",
        "CGE",
        "UX4 HUD",
        "PS5"
      ],
      "phase": "probe in PS0-PS3 GTA session; before PS2 player speech, CGE player-listening/source-time probe (10b), social routing; playback-only 10a uses existing events",
      "feasibility": "UNKNOWN",
      "frames": {
        "utterance.started": [
          "utteranceId",
          "hostRunId",
          "inputSource",
          "micPed.captureRef",
          "selectionProvenance",
          "startGameTick",
          "startMonotonicMs"
        ],
        "utterance.turn": [
          "utteranceId",
          "pedId",
          "sessionNonce",
          "turnId"
        ],
        "utterance.ended": [
          "utteranceId",
          "endGameTick",
          "endMonotonicMs",
          "terminal"
        ]
      },
      "enums": {
        "inputSource": [
          "stock_talk",
          "marked_talk",
          "ux4_ptt",
          "typed"
        ],
        "terminal": [
          "captured",
          "cancelled",
          "empty",
          "overflow"
        ]
      },
      "rules": [
        "typed input: zero duration, no observers",
        "hearing evaluated only over [start,end]",
        "one STT per utterance"
      ],
      "risks": [
        "R-01"
      ]
    },
    {
      "id": "C-02",
      "name": "Shared anchor service + observer identity index",
      "owner": "Plane 2 RuntimeEntry (EntityAnchors promoted)",
      "consumers": [
        "PS",
        "ACT",
        "UX4",
        "CGE",
        "Director",
        "PS3/PS4"
      ],
      "phase": "before ACT3 and PS4",
      "native": [
        "Retain(ped, reason, ownerLifetime?) -> captureRef",
        "Resolve(captureRef) -> Ped|null",
        "Retire(captureRef, reason)"
      ],
      "companionIndex": "captureRef -> {kind, encounterId?, incarnationId?, owned}; CharacterId only for owned anchors via P1 binding; recognition gate before model use",
      "risks": [
        "R-03"
      ]
    },
    {
      "id": "C-03",
      "name": "SalienceConsumption acknowledgement",
      "owner": "PS3",
      "consumers": [
